# Port the API listens on
PORT=5000
# MongoDB Atlas connection string (Atlas → Connect → Drivers). Keep /taskflow as the DB name.
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow
# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
# How long issued tokens stay valid
JWT_EXPIRES_IN=7d
